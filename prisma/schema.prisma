// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model system {
  id    String     @id @unique @default(uuid())
  name  systemType @unique
  value String
}

enum systemType {
  NUMBER_OF_VISITOR
}

model company {
  id           String        @id @unique @default(uuid())
  name         String        @unique
  location     String
  subscription subscription?
  clients      client[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        user[]
  ways         way[]
  notes        note[]
  shipments    shipment[]
}

model subscription {
  id        String             @id @default(uuid())
  typeId    String
  type      SubscriptionType   @relation(fields: [typeId], references: [id], name: "current Subscription")
  newTypeId String?
  newType   SubscriptionType?  @relation(fields: [newTypeId], references: [id], name: "when Company Change Subscription")
  status    SubscriptionStatus @default(pending)
  startDate DateTime?
  endDate   DateTime?
  company   company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String             @unique
}

model SubscriptionType {
  id              String         @id @default(uuid())
  type            String         @unique
  price           Float
  durationByMonth Int            @unique
  subscription    subscription[] @relation(name: "current Subscription")
  newSubscription subscription[] @relation(name: "when Company Change Subscription")
}

enum SubscriptionStatus {
  pending
  active
  inactive
  expired
  change
}

model client {
  id            String         @id @default(uuid())
  name          String
  companyId     String
  company       company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactWays   contactWay[]
  shipments     shipment[]
  shipmentItems shipmentItem[]

  @@unique([name, companyId])
}

model contactWay {
  id          String      @id @default(uuid())
  text        String      @unique
  isPrimary   Boolean     @default(false)
  contactType contactType @default(phoneNumber)
  clientId    String
  client      client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum contactType {
  phoneNumber
  email
}

model user {
  id          String     @id @default(uuid())
  userName    String
  email       String     @unique
  password    String
  isAdmin     Boolean    @default(false)
  isManager   Boolean    @default(false)
  isEmployee  Boolean    @default(true)
  isDriver    Boolean    @default(false)
  companyId   String?
  company     company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipments   shipment[]
  phoneNumber String?
  createAt    DateTime   @default(now())
  updateAt    DateTime   @updatedAt
}

model way {
  id        String     @id @default(uuid())
  name      String
  companyId String
  company   company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  points    point[]
  shipments shipment[]

  @@unique([name, companyId])
}

model point {
  id        String     @id @default(uuid())
  name      String
  order     Int
  wayId     String
  way       way        @relation(fields: [wayId], references: [id], onDelete: Cascade)
  shipments shipment[]
  lat       Decimal?
  lng       Decimal?

  @@unique([wayId, name])
  @@unique([wayId, order])
}

model note {
  id        String   @id @default(uuid())
  type      NoteType
  text      String
  createdAt DateTime @default(now())
  companyId String
  company   company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum NoteType {
  complaint
  inquiry
  suggestion
  compliment
  feedback
  other
}

model shipment {
  id             String         @id @default(uuid())
  shipmentNumber String         @unique
  launchDate     DateTime
  endDate        DateTime?
  wayId          String
  way            way            @relation(fields: [wayId], references: [id], onDelete: Cascade)
  currentPointId String?
  currentPoint   point?         @relation(fields: [currentPointId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         user?          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  client         client[]
  shipmentItems  shipmentItem[]
  companyId      String
  company        company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isPaused       Boolean        @default(false)
  isCompleted    Boolean        @default(false)
  createAt       DateTime       @default(now()) 

  @@unique([shipmentNumber, companyId])
}

model shipmentItem {
  id          String   @id @default(uuid())
  name        String
  quantity    Int
  isBreakable Boolean  @default(false)
  clientId    String
  client      client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  shipmentId  String
  shipment    shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([name, clientId])
}
